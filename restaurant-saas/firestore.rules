// firestore.rules
// ═══════════════════════════════════════════════════════════════
// FIRESTORE SECURITY RULES — Saqlyn
// ═══════════════════════════════════════════════════════════════

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    // Multi-branch owners: a general_admin's users doc lists every branch
    // they may open in `restaurant_ids` (their first branch is still
    // restaurant_id). Staff logins stay per-branch — only the owner
    // switches. Every staff check below routes through this.
    function isOwnRestaurant(restaurantId) {
      return isAuthenticated() &&
        (getUserData().restaurant_id == restaurantId ||
         restaurantId in getUserData().get('restaurant_ids', []));
    }

    function isGeneralAdmin(restaurantId) {
      return isAuthenticated() &&
        getUserData().role == 'general_admin' &&
        isOwnRestaurant(restaurantId);
    }

    function isStaff(restaurantId) {
      return isAuthenticated() &&
        isOwnRestaurant(restaurantId) &&
        getUserData().role in ['general_admin', 'kitchen', 'cash_counter', 'server'];
    }

    function isKitchen(restaurantId) {
      return isAuthenticated() &&
        getUserData().role == 'kitchen' &&
        isOwnRestaurant(restaurantId);
    }

    function isCashCounter(restaurantId) {
      return isAuthenticated() &&
        getUserData().role == 'cash_counter' &&
        isOwnRestaurant(restaurantId);
    }

    function isServer(restaurantId) {
      return isAuthenticated() &&
        getUserData().role == 'server' &&
        isOwnRestaurant(restaurantId);
    }

    function isPaymentStaff() {
      return isAuthenticated() &&
        getUserData().role in ['general_admin', 'cash_counter', 'server', 'super_admin'];
    }

    function isOrderStatusValid(status) {
      return status in ['pending', 'confirmed', 'preparing', 'ready', 'out_for_delivery', 'delivered', 'served', 'paid', 'cancelled'];
    }

    function isPaymentStatusValid(status) {
      return status in ['unpaid', 'paid'];
    }

    function isValidOrderCreate() {
      return request.resource.data.keys().hasAll([
          'id', 'table_number', 'items', 'status', 'total',
          'payment_status', 'payment_method', 'created_at',
          'updated_at', 'estimated_ready', 'notes', 'created_by'
        ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.table_number is int
        && request.resource.data.table_number >= 0
        && request.resource.data.table_number <= 500
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'pending'
        && request.resource.data.payment_status == 'unpaid'
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 300
        && request.resource.data.created_by is string
        && request.resource.data.get('order_type', 'dine_in') in ['dine_in', 'delivery']
        // Delivery orders carry no table (0) and must bring the customer's
        // details + a non-negative fee; dine-in orders always have a table.
        && (request.resource.data.get('order_type', 'dine_in') != 'delivery'
            || (request.resource.data.table_number == 0
                && request.resource.data.get('customer_name', '') is string
                && request.resource.data.get('customer_name', '').size() > 0
                && request.resource.data.get('customer_phone', '') is string
                && request.resource.data.get('customer_phone', '').size() > 0
                && request.resource.data.get('delivery_address', '') is string
                && request.resource.data.get('delivery_address', '').size() > 0
                && request.resource.data.get('delivery_fee', 0) is number
                && request.resource.data.get('delivery_fee', 0) >= 0))
        && (request.resource.data.get('order_type', 'dine_in') == 'delivery'
            || request.resource.data.table_number >= 1);
    }

    function isOrderUpdateAllowed(restaurantId) {
      return isSuperAdmin() ||
        isGeneralAdmin(restaurantId) ||
        isKitchen(restaurantId) ||
        isCashCounter(restaurantId);
    }

    // ── Plan limits (Basic 10 / Standard 20 / Premium 50) ──────────────
    // A restaurant admin may lower the table count anytime, but never raise
    // it above the plan's limit. A count already above the limit (e.g. after
    // a downgrade) may stay, but may not grow further. Only the super admin
    // may change a restaurant's plan.
    // A restaurant admin may never move the plan's expiry date.
    function trialFieldsUnchanged() {
      return !('plan_expires_at' in request.resource.data.diff(resource.data).affectedKeys());
    }

    function planTableLimit(plan) {
      return plan == 'basic' ? 10
        : (plan == 'premium' || plan == 'unlimited') ? 50
        : 20;
    }
    // A restaurant's general admin may create staff accounts for their OWN
    // restaurant (kitchen / cash / server / admin) — never a super admin.
    // (The staff-login cap itself is enforced in the app; rules cannot count
    // documents in a collection.)
    function isStaffCreateAllowed() {
      return isAuthenticated()
        && getUserData().role == 'general_admin'
        && isOwnRestaurant(request.resource.data.restaurant_id)
        && request.resource.data.role in ['general_admin', 'kitchen', 'cash_counter', 'server'];
    }
    // Same, for removing a staff member: the EXISTING record must belong to
    // the caller's own restaurant and be a staff role (never super admin).
    function isStaffDeleteAllowed() {
      return isAuthenticated()
        && getUserData().role == 'general_admin'
        && isOwnRestaurant(resource.data.restaurant_id)
        && resource.data.role in ['general_admin', 'kitchen', 'cash_counter', 'server']
        && resource.data.get('is_platform_owner', false) != true;
    }
    function planUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']);
    }
    // A restaurant's general admin may never freeze or unfreeze their own
    // restaurant — only the super admin touches is_frozen.
    function frozenUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_frozen']);
    }
    // A restaurant's general admin may never set their own custom domain —
    // only the super admin (or the Worker) links one, after it is bought
    // and attached. They MAY request one (domain_request) — that is the
    // intended flow in Settings and it passes the update rule below.
    function customDomainUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['custom_domain']);
    }
    // A user may never disable or enable their own login — only the super
    // admin touches is_disabled.
    function disabledUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['is_disabled']);
    }
    function tableCountWithinLimit() {
      let oldCount = resource.data.get('table_count', 0);
      let newCount = request.resource.data.get('table_count', oldCount);
      let plan = request.resource.data.get('plan', resource.data.get('plan', 'standard'));
      return newCount <= oldCount || newCount <= planTableLimit(plan);
    }

    // ── Users ─────────────────────────────────────────────────
    match /users/{userId} {
      // A restaurant's general admin can read the staff of their OWN
      // restaurant (StaffModal list + plan cap). Nobody can read another
      // restaurant's staff — kitchen / cash / server can only read
      // themselves, and the super admin can read everyone.
      // NOTE: do NOT add per-document conditions (role / is_platform_owner)
      // to this read rule — a list query is rejected wholesale when the
      // query cannot prove every returned doc satisfies the rule, and
      // that broke the staff list (403). The hiding is done in the app
      // (getRestaurantUsers filters super_admin + is_platform_owner);
      // the rules below still block DELETING a platform account.
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isSuperAdmin()
        || (getUserData().role == 'general_admin'
            && isOwnRestaurant(resource.data.restaurant_id))
      );
      allow create: if isSuperAdmin() || isStaffCreateAllowed();
      // Super admin can change anything (incl. disabling a login). A user
      // may update their own record but never their own disabled flag.
      allow update: if isSuperAdmin() || (request.auth.uid == userId && disabledUnchanged());
      allow delete: if isSuperAdmin() || isStaffDeleteAllowed();
    }

    // ── Restaurants ───────────────────────────────────────────
    match /restaurants/{restaurantId} {
      // Anyone can read a restaurant (needed for customer menu)
      allow read: if true;

      // Only super admin can create/delete restaurants
      allow create, delete: if isSuperAdmin();

      // Super admin can change anything. A restaurant's general admin can
      // update everything except the plan, and may not raise the table count
      // above the plan's limit (lowering it is always allowed). They may
      // never touch the plan expiry, the freeze flag, or the custom domain.
      allow update: if isSuperAdmin()
        || (isGeneralAdmin(restaurantId) && planUnchanged() && tableCountWithinLimit() && trialFieldsUnchanged() && frozenUnchanged() && customDomainUnchanged());

      // ── Menu Items ──────────────────────────────────────────
      match /menu/{itemId} {
        // Anyone can read menu items (for customer ordering)
        allow read: if true;

        // Only general admin or super admin can write
        allow write: if isSuperAdmin() || isGeneralAdmin(restaurantId);
      }

      // ── Orders ──────────────────────────────────────────────
      match /orders/{orderId} {
        // Customers can create orders (unauthenticated), but only if payload is valid
        allow create: if isValidOrderCreate();

        // Anyone can read orders — customers track their own table's order
        // (the app filters client-side by table_number). Demo trade-off:
        // for a real restaurant, restrict this to staff + per-table tokens.
        allow read: if true;

        // Staff status/payment updates with constrained values.
        // The kitchen may move an order along (confirm → serve) but may
        // NEVER cancel/delete one: a wrong confirmed order is deleted by
        // the cashier or the admin only (his 2026-11-16 decision).
        // A per-order manual discount (manual_discount_* fields) may be
        // set or removed ONLY by the restaurant admin or the super admin
        // (his 2026-11-17 decision) — the cashier and the kitchen can
        // still move statuses, they just cannot touch the discount.
        allow update: if isOrderUpdateAllowed(restaurantId)
          && isOrderStatusValid(request.resource.data.status)
          && isPaymentStatusValid(request.resource.data.payment_status)
          && (request.resource.data.status != 'cancelled' || !isKitchen(restaurantId))
          && request.resource.data.total == resource.data.total
          && request.resource.data.items == resource.data.items
          && request.resource.data.table_number == resource.data.table_number
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['manual_discount_type', 'manual_discount_value', 'manual_discount_amount', 'manual_discount_by', 'manual_discount_by_name', 'manual_discount_at']) || isGeneralAdmin(restaurantId) || isSuperAdmin());

        // A server may cancel (soft-delete) an order, but ONLY while it is
        // still pending — before the kitchen confirms it. Nothing else may
        // change: same payment state, same bill, same items, same table.
        allow update: if isServer(restaurantId)
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.payment_status == resource.data.payment_status
          && request.resource.data.total == resource.data.total
          && request.resource.data.items == resource.data.items
          && request.resource.data.table_number == resource.data.table_number;

        // A customer may cancel their OWN order, but ONLY while it is still
        // pending — before the kitchen confirms it. The canceller must prove
        // they placed it: cancelled_by must equal the session id that
        // created the order (created_by, a "cust_…" id). Nothing else may
        // change: same payment state, same bill, same items, same table.
        // Honest limit: order docs are readable by design (table tracking),
        // so anyone who reads an order can also see its created_by — this
        // is the same public-read trade-off the site already accepts, not a
        // per-table token. A proper fix is per-table tokens (bigger change).
        allow update: if resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && resource.data.created_by is string
          && resource.data.created_by.matches('^cust_.*')
          && request.resource.data.cancelled_by == resource.data.created_by
          && request.resource.data.payment_status == resource.data.payment_status
          && request.resource.data.total == resource.data.total
          && request.resource.data.items == resource.data.items
          && request.resource.data.table_number == resource.data.table_number;

        // Delete: the super admin, or the restaurant's own general admin
        // (his 2026-11-19 decision — so a restaurant admin can remove a
        // test / wrong order from Order History). The kitchen, cashier
        // and server can never delete an order.
        allow delete: if isSuperAdmin() || isGeneralAdmin(restaurantId);
      }
    }

    // ── Payments (top-level collection) ───────────────────────
    // Customers create payment proof records (unauthenticated allowed)
    // Staff can read and verify payments for their restaurant
    match /payments/{paymentId} {
      // Anyone can create a payment record (unauthenticated customers)
      allow create: if request.resource.data.keys().hasAll([
          'id', 'restaurantId', 'tableNumber', 'amount',
          'status', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.tableNumber is int
        && request.resource.data.tableNumber >= 0; // 0 = home delivery payment

      // Authenticated staff can read payments
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        (isPaymentStaff() && getUserData().restaurant_id == resource.data.restaurantId)
      );

      // Cash counter and admin can verify (update) payments
      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          getUserData().role in ['general_admin', 'cash_counter'] &&
          getUserData().restaurant_id == resource.data.restaurantId &&
          request.resource.data.status == 'verified' &&
          resource.data.status == 'pending'
        )
      );

      // Only super admin can delete payment records
      allow delete: if isSuperAdmin();
    }

    // ── Plan Payments (owner buys a plan, super admin verifies) ─────
    // A restaurant's general admin creates a payment proof record for their
    // own restaurant. Only the super admin may verify or reject it — the
    // activation (plan + 30-day expiry) happens in the app when the super
    // admin verifies.
    match /plan_payments/{paymentId} {
      allow create: if isAuthenticated()
        && isGeneralAdmin(request.resource.data.restaurantId)
        && request.resource.data.keys().hasAll([
            'id', 'restaurantId', 'plan', 'amount',
            'method', 'status', 'createdAt'
          ])
        && request.resource.data.status == 'pending'
        && request.resource.data.plan in ['basic', 'standard', 'premium']
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;

      // The restaurant's general admin and the super admin can read them
      allow read: if isAuthenticated() && (
        isSuperAdmin() || isGeneralAdmin(resource.data.restaurantId)
      );

      // Only the super admin can verify or reject (pending -> decided)
      allow update: if isSuperAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['verified', 'rejected'];

      allow delete: if isSuperAdmin();
    }

    // ── Signup Requests (Get Started page) ──────────────────────────
    // Prospects submit these without logging in. Anyone can create one
    // (validated payload below); only the super admin can read or change
    // them — the customer never sees other requests.
    match /signup_requests/{requestId} {
      allow create: if request.resource.data.keys().hasAll([
          'id', 'plan', 'amount', 'restaurantName', 'ownerName',
          'whatsapp', 'city', 'cuisine', 'tables', 'notes',
          'status', 'createdAt'
        ])
        && request.resource.data.plan in ['basic', 'standard', 'premium']
        && request.resource.data.status == 'new'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.restaurantName is string
        && request.resource.data.restaurantName.size() >= 2
        && request.resource.data.restaurantName.size() <= 80
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() >= 2
        && request.resource.data.ownerName.size() <= 80
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 10
        && request.resource.data.whatsapp.size() <= 15
        && request.resource.data.city is string
        && request.resource.data.city.size() >= 2
        && request.resource.data.city.size() <= 60
        && request.resource.data.cuisine is string
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 300
        && request.resource.data.tables is int
        && request.resource.data.tables >= 1
        && request.resource.data.tables <= 50;

      allow read, update, delete: if isSuperAdmin();
    }

    // ── Demo Leads (Try Demo page) ──────────────────────────────────
    // A visitor who adds their own menu item to a demo restaurant
    // leaves their contact details first. Anyone can create one
    // (validated payload below); only the super admin can read them.
    match /demo_leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll([
          'id', 'name', 'email', 'whatsapp', 'restaurantId',
          'restaurantName', 'source', 'status', 'createdAt'
        ])
        && request.resource.data.status == 'new'
        && request.resource.data.source == 'demo-menu-add'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*\\..*')
        && request.resource.data.email.size() <= 120
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 10
        && request.resource.data.whatsapp.size() <= 15
        && request.resource.data.restaurantId is string
        && request.resource.data.restaurantName is string;

      allow read, update, delete: if isSuperAdmin();
    }

    // ── Domain Mappings ───────────────────────────────────────
    match /domain_mappings/{domain} {
      allow read: if true; // needed for domain resolution
      allow write: if isSuperAdmin();
    }

    // ── Platform Settings ───────────────────────────────────────
    match /platform_settings/{docId} {
      // Anyone can read the plan limits (the apps need them for the UI)
      allow read: if true;
      // Only the super admin can change them
      allow write: if isSuperAdmin();
    }
  }
}
